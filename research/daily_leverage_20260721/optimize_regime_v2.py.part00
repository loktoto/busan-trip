@dataclass(frozen=True)
class AssetSpec:
    name: str
    native: tuple[tuple[str, float], ...]
    implementations: tuple[tuple[str, tuple[tuple[str, float], ...], float, float, float], ...]
    breadth_num: str
    breadth_den: str
    start: str
    development_end: str
    min_changes: int
    trend_mas: tuple[int, ...]
    trend_slopes: tuple[int, ...]
    rsi_entries: tuple[int, ...]
    lookbacks: tuple[int, ...]
    reclaims: tuple[int, ...]
    rsi_exits: tuple[int, ...]
    exit_mas: tuple[int | None, ...]
    target_vols: tuple[float | None, ...]
    component_gate: bool = False
    experimental: bool = False


