
import hashlib


def _extract_download_fallback(raw: pd.DataFrame, ticker: str) -> pd.DataFrame | None:
    if raw.empty:
        return None
    if isinstance(raw.columns, pd.MultiIndex):
        level0 = raw.columns.get_level_values(0)
        level1 = raw.columns.get_level_values(1)
        if ticker in level0:
            df = raw[ticker].copy()
        elif ticker in level1:
            df = raw.xs(ticker, axis=1, level=1).copy()
        else:
            # A one-ticker yfinance response can retain a redundant ticker level.
            df = raw.droplevel(1, axis=1).copy() if len(set(level1)) == 1 else None
            if df is None:
                return None
    else:
        df = raw.copy()
    df.columns = [str(c).title() for c in df.columns]
    needed = ["Open", "High", "Low", "Close", "Volume"]
    if any(column not in df.columns for column in needed):
        return None
    df = df[needed].dropna(subset=["Open", "Close"]).sort_index()
    df.index = pd.to_datetime(df.index).tz_localize(None)
    if df.index.has_duplicates:
        df = df[~df.index.duplicated(keep="last")]
    return None if df.empty else df.astype(float)


def _frame_fingerprint(frame: pd.DataFrame) -> str:
    normalised = frame[["Open", "High", "Low", "Close", "Volume"]].round(8)
    payload = pd.util.hash_pandas_object(normalised, index=True).values.tobytes()
    return hashlib.sha256(payload).hexdigest()


def download_with_retry(tickers: Iterable[str], start: str = "2008-01-01") -> dict[str, pd.DataFrame]:
    """Download each required ticker sequentially and persist auditable input hashes."""
    tickers = sorted(set(tickers))
    result: dict[str, pd.DataFrame] = {}
    diagnostics: list[str] = []
    input_dir = OUT / "input_data"
    input_dir.mkdir(parents=True, exist_ok=True)
    manifest: dict[str, dict[str, object]] = {}

    for ticker in tickers:
        last_error: Exception | None = None
        frame: pd.DataFrame | None = None
        for attempt in range(5):
            try:
                raw = yf.download(
                    ticker,
                    start=start,
                    end=END_DATE,
                    auto_adjust=True,
                    actions=False,
                    progress=False,
                    threads=False,
                    group_by="column",
                )
                frame = _extract_download_fallback(raw, ticker)
                if frame is not None:
                    break
            except Exception as exc:  # pragma: no cover - network retry path
                last_error = exc
            time.sleep(3 * (attempt + 1))
        if frame is None:
            diagnostics.append(f"{ticker}: {last_error or 'empty response'}")
            continue

        result[ticker] = frame
        safe = ticker.replace("^", "INDEX_").replace("/", "_")
        frame.to_csv(input_dir / f"{safe}.csv.gz", compression="gzip", float_format="%.10g")
        manifest[ticker] = {
            "rows": int(len(frame)),
            "start": str(frame.index.min().date()),
            "end": str(frame.index.max().date()),
            "sha256": _frame_fingerprint(frame),
            "first_close": float(frame.Close.iloc[0]),
            "last_close": float(frame.Close.iloc[-1]),
        }

    missing = sorted(set(tickers) - set(result))
    if missing:
        raise RuntimeError(
            f"Missing required tickers {missing}; diagnostics: {' | '.join(diagnostics)}"
        )

    aggregate = hashlib.sha256(
        "\n".join(f"{ticker}:{manifest[ticker]['sha256']}" for ticker in sorted(manifest)).encode()
    ).hexdigest()
    (OUT / "input_manifest.json").write_text(
        json.dumps(
            {
                "provider": "Yahoo Finance via yfinance",
                "download_mode": "sequential single-ticker, auto-adjusted, completed through 2026-07-20",
                "aggregate_sha256": aggregate,
                "tickers": manifest,
            },
            indent=2,
        )
    )
    return result


if __name__ == "__main__":
    main()
