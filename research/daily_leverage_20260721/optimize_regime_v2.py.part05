    if baseline_short.empty:
        baseline_short = baseline_grid.head(15).copy()

    benchmark = open_to_open_return(native).iloc[:-1]
    holdout_start = str((development_end + pd.Timedelta(days=1)).date())
    results = []
    return_cache: dict[tuple, tuple[pd.Series, pd.Series]] = {}
    for row in baseline_short.itertuples():
        for impl_name, _, max_leverage, product_leverage, cost_bps in spec.implementations:
            levered = implementation_frames[impl_name]
            for overlay, target_vol in itertools.product(OVERLAYS, spec.target_vols):
                candidate = Candidate(int(row.baseline_id), impl_name, overlay, target_vol)
                returns, leverage = run_returns(
                    native,
                    levered,
                    states[candidate.baseline_id],
                    features,
                    overlay,
                    target_vol,
                    max_leverage,
                    product_leverage,
                    cost_bps,
                )
                return_cache[(candidate.baseline_id, impl_name, overlay, target_vol)] = (returns, leverage)
                fold_metrics = []
                for train_start, train_end, test_start, test_end in folds:
                    train = interval_metrics(returns, benchmark, train_start, train_end)
                    test = interval_metrics(returns, benchmark, test_start, test_end)
                    fold_metrics.append((train, test))
                dev = interval_metrics(returns, benchmark, str(common.min().date()), str(development_end.date()))
                holdout = interval_metrics(returns, benchmark, holdout_start, str(common.max().date()))
                stress_returns, _ = run_returns(
                    native,
                    levered,
                    states[candidate.baseline_id],
                    features,
                    overlay,
                    target_vol,
                    max_leverage,
                    product_leverage,
                    max(cost_bps * 2.0, cost_bps + 20.0),
                )
                stress_dev = interval_metrics(
                    stress_returns,
                    benchmark,
                    str(common.min().date()),
                    str(development_end.date()),
                )
                stress_full = interval_metrics(
                    stress_returns,
                    benchmark,
                    str(common.min().date()),
                    str(common.max().date()),
                )
                results.append({
                    **asdict(candidate),
                    "development_excess": dev["excess"],
                    "development_sharpe_excess": dev["sharpe_excess"],
                    "development_dd_delta": dev["dd_delta"],
                    "fold_test_excess_median": np.nanmedian([x[1]["excess"] for x in fold_metrics]),
                    "fold_test_excess_worst": np.nanmin([x[1]["excess"] for x in fold_metrics]),
                    "fold_test_sharpe_median": np.nanmedian([x[1]["sharpe_excess"] for x in fold_metrics]),
                    "fold_test_dd_worst": np.nanmin([x[1]["dd_delta"] for x in fold_metrics]),
                    "holdout_cagr": holdout["cagr"],
                    "holdout_excess": holdout["excess"],
                    "holdout_sharpe_excess": holdout["sharpe_excess"],
                    "holdout_dd_delta": holdout["dd_delta"],
                    "stress_development_excess": stress_dev["excess"],
                    "stress_full_excess": stress_full["excess"],
                    "avg_leverage": float(leverage.mean()),
                    "max_leverage_observed": float(leverage.max()),
                    "changes": int((leverage.diff().abs() > 0.05).sum()),
                    "current_leverage": float(leverage.iloc[-1]),
                })

    grid = pd.DataFrame(results)
    grid["development_pass"] = (
        (grid.development_excess.round(METRIC_DECIMALS) > 0)
        & (grid.development_sharpe_excess.round(METRIC_DECIMALS) >= 0)
        & (grid.development_dd_delta.round(METRIC_DECIMALS) >= -0.03)
        & (grid.fold_test_excess_median.round(METRIC_DECIMALS) > 0)
        & (grid.fold_test_excess_worst.round(METRIC_DECIMALS) > -0.01)
        & (grid.fold_test_dd_worst.round(METRIC_DECIMALS) >= -0.04)
        & (grid.stress_development_excess.round(METRIC_DECIMALS) > 0)
        & (grid.changes >= spec.min_changes)
    )
    dev = grid[grid.development_pass].copy()
    if dev.empty:
        dev = grid.copy()
    rank_columns = (
        "development_excess",
        "development_sharpe_excess",
        "fold_test_excess_median",
        "fold_test_sharpe_median",
        "stress_development_excess",
        "fold_test_dd_worst",
    )
    for col in rank_columns:
        dev[col + "_rank"] = quantised_rank(dev[col])
    dev["development_score"] = (
        0.20 * dev.development_excess_rank
        + 0.15 * dev.development_sharpe_excess_rank
        + 0.25 * dev.fold_test_excess_median_rank
        + 0.15 * dev.fold_test_sharpe_median_rank
        + 0.15 * dev.stress_development_excess_rank
        + 0.10 * dev.fold_test_dd_worst_rank
    )
    dev["development_score_q"] = dev.development_score.round(6)
    dev["fold_excess_q"] = dev.fold_test_excess_median.round(METRIC_DECIMALS)
    dev["stress_excess_q"] = dev.stress_development_excess.round(METRIC_DECIMALS)
    dev["target_vol_sort"] = dev.target_vol.fillna(-1.0)
    dev = dev.sort_values(
        [
            "development_score_q", "fold_excess_q", "stress_excess_q",
            "baseline_id", "implementation", "overlay", "target_vol_sort",
        ],
        ascending=[False, False, False, True, True, True, True],
        kind="mergesort",
    )
    development_shortlist = dev.head(30).copy()
    development_shortlist["holdout_pass"] = (
        (development_shortlist.holdout_excess.round(METRIC_DECIMALS) > 0)
        & (development_shortlist.holdout_sharpe_excess.round(METRIC_DECIMALS) >= -0.05)
        & (development_shortlist.holdout_dd_delta.round(METRIC_DECIMALS) >= -0.03)
    )
    winner = development_shortlist.iloc[0].to_dict()
    winner_target_vol = None if pd.isna(winner["target_vol"]) else float(winner["target_vol"])
