{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/loktoto/busan-trip/research/market-bottom/live-input.schema.json",
  "title": "Bottom Zone Monitor IBKR Input",
  "type": "object",
  "required": ["schema_version", "request_id", "created_at", "source", "bar_status", "assets"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "request_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "source": {"const": "IBKR"},
    "bar_status": {"enum": ["LATEST_RTH_CLOSE", "INTRADAY_CONTEXT"]},
    "model_commit": {"type": "string"},
    "assets": {
      "type": "object",
      "required": ["SPY", "QQQ", "SOXX", "SMH"],
      "additionalProperties": false,
      "properties": {
        "SPY": {"$ref": "#/$defs/asset"},
        "QQQ": {"$ref": "#/$defs/asset"},
        "SOXX": {"$ref": "#/$defs/asset"},
        "SMH": {"$ref": "#/$defs/asset"}
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "bar": {
      "type": "object",
      "required": ["Date", "Open", "High", "Low", "Close", "Volume"],
      "properties": {
        "Date": {"type": "string"},
        "Open": {"type": "number", "exclusiveMinimum": 0},
        "High": {"type": "number", "exclusiveMinimum": 0},
        "Low": {"type": "number", "exclusiveMinimum": 0},
        "Close": {"type": "number", "exclusiveMinimum": 0},
        "Volume": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": ["bars"],
      "properties": {
        "bars": {"type": "array", "minItems": 260, "items": {"$ref": "#/$defs/bar"}},
        "features": {"type": "array", "items": {"type": "object"}},
        "snapshot": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}
